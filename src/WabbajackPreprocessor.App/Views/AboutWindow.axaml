<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:WabbajackPreprocessor.App.Localization"
        x:Class="WabbajackPreprocessor.App.Views.AboutWindow"
        Title="{Binding [AboutTitle], Source={x:Static loc:L.Instance}}"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/avalonia-logo.ico">

    <StackPanel Margin="16" Spacing="8">
        <TextBlock FontSize="16" FontWeight="SemiBold"
                   Text="{Binding [AboutAppName], Source={x:Static loc:L.Instance}}" />
        <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.8" />
        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Text="{Binding [AboutDescription], Source={x:Static loc:L.Instance}}" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Click="OnRepoClicked"
                    Content="{Binding [AboutRepoButton], Source={x:Static loc:L.Instance}}" />
            <Button IsDefault="True" IsCancel="True" Click="OnCloseClicked"
                    Content="{Binding [CloseButton], Source={x:Static loc:L.Instance}}" />
        </StackPanel>
    </StackPanel>
</Window>
