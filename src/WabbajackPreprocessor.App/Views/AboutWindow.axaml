<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WabbajackPreprocessor.App.Views.AboutWindow"
        Title="About"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/avalonia-logo.ico">

    <StackPanel Margin="16" Spacing="8">
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Wabbajack Compiler Settings Preprocessor" />
        <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.8" Text="Version" />
        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Text="A cleanup tool for Wabbajack modlist authors. A supplement to Wabbajack, not a replacement — compile your list in Wabbajack itself. MIT licensed." />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Content="GitHub repository" Click="OnRepoClicked" />
            <Button Content="Close" IsDefault="True" IsCancel="True" Click="OnCloseClicked" />
        </StackPanel>
    </StackPanel>
</Window>
