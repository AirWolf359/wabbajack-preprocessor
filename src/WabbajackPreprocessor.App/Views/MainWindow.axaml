<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WabbajackPreprocessor.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="650"
        x:Class="WabbajackPreprocessor.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="950" Height="650"
        MinWidth="860" MinHeight="480"
        Title="Wabbajack Compiler Settings Preprocessor">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.detail">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.itemTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#40808080" />
        </Style>

        <!-- Compact, unmistakably tab-shaped headers on a single non-wrapping strip
             (the Fluent default renders headers as 24px heading text on a WrapPanel). -->
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="0,8,0,0" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
        </Style>
        <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#14808080" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#26808080" />
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#38808080" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="12">

        <!-- Top: file selection -->
        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock Text="Compiler settings file (.compiler_settings)" />
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding SettingsPath}"
                         AutomationProperties.Name="Compiler settings file path"
                         PlaceholderText="Path to your &lt;modlist&gt;.compiler_settings file" />
                <Button Grid.Column="1" Margin="6,0,0,0" Content="Browse…" Click="OnBrowseClicked" />
                <Button Grid.Column="2" Margin="6,0,0,0" Content="Analyze"
                        Command="{Binding AnalyzeCommand}" Classes="accent" />
            </Grid>
            <TextBlock Classes="detail" Text="{Binding InstanceSummary}" />
            <TextBlock Text="{Binding ProfilesSummary}" TextWrapping="Wrap"
                       IsVisible="{Binding HasAnalysis}" />
        </StackPanel>

        <!-- Bottom: status + apply -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Status"
                       Text="{Binding StatusMessage}" />
            <Button Grid.Column="1" Content="Apply changes" Classes="accent"
                    Command="{Binding ApplyCommand}" />
        </Grid>

        <!-- Findings -->
        <TabControl Margin="0,10,0,0">

            <TabItem Header="{Binding StaleHeader}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="detail" Margin="0,4,0,6"
                               Text="Dead references in the settings file's tag lists: entries pointing at files or folders that no longer exist, and duplicates. Removing them never changes what gets compiled. Checked entries are removed when you apply." />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding StaleGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StaleGroup">
                                    <StackPanel Margin="0,0,0,14">
                                        <Border BorderThickness="0,0,0,2"
                                                BorderBrush="{DynamicResource SystemAccentColor}"
                                                Padding="0,0,0,4" Margin="0,6,0,0">
                                            <TextBlock FontSize="15" FontWeight="SemiBold"
                                                       Text="{Binding Header}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding SubGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:StaleSubGroup">
                                                    <StackPanel>
                                                        <TextBlock FontSize="13" FontWeight="SemiBold" Opacity="0.85"
                                                                   Margin="0,8,0,2" Text="{Binding Header}" />
                                                        <ItemsControl ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:StaleEntryItem">
                                                                    <Border Classes="row">
                                                                        <Grid ColumnDefinitions="Auto,*">
                                                                            <CheckBox Grid.Column="0" VerticalAlignment="Top"
                                                                                      IsChecked="{Binding Remove}"
                                                                                      AutomationProperties.Name="{Binding Entry, StringFormat='Remove {0} from the settings file'}" />
                                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                                <TextBlock Classes="itemTitle" Text="{Binding Entry}" />
                                                                                <TextBlock Classes="detail" Text="{Binding Detail}"
                                                                                           IsVisible="{Binding HasDetail}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="{Binding RedundantHeader}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="detail" Margin="0,4,0,6"
                               Text="Mods still in the list whose Always Enabled tag currently does nothing, because the mod is enabled in every selected profile that lists it. (A mod disabled in even one selected profile is not shown — there the tag preserves that profile's disabled line.) Checking a mod removes its tag when you apply; keep the tag if you might disable the mod later." />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding RedundantItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StaleEntryItem">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <CheckBox Grid.Column="0" VerticalAlignment="Top"
                                                      IsChecked="{Binding Remove}"
                                                      AutomationProperties.Name="{Binding Entry, StringFormat='Remove the Always Enabled tag from {0}'}"
                                                      ToolTip.Tip="Remove the Always Enabled tag" />
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Classes="itemTitle" Text="{Binding Entry}" />
                                                <TextBlock Classes="detail" Text="{Binding Detail}"
                                                           IsVisible="{Binding HasDetail}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="{Binding DisabledHeader}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="detail" Margin="0,4,0,6"
                               Text="Mods that are disabled in every selected profile. Wabbajack skips them unless you mark them Always Enabled (their files ship, still disabled, for users to opt into)." />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding DisabledItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DisabledModItem">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <CheckBox Grid.Column="0" VerticalAlignment="Top"
                                                      IsChecked="{Binding MarkAlwaysEnabled}"
                                                      AutomationProperties.Name="{Binding ModName, StringFormat='Mark {0} as Always Enabled'}"
                                                      ToolTip.Tip="Add to AlwaysEnabled" />
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Classes="itemTitle" Text="{Binding ModName}" />
                                                <TextBlock Classes="detail" Text="{Binding Note}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="{Binding DownloadsHeader}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="detail" Margin="0,4,0,6"
                               Text="Mods that will be compiled but can't be traced to a download archive. Their files must be inlined into the modlist: Include embeds them unconditionally; No match include embeds only what nothing else matches (the usual choice for generated content). Each row shows the mod's current tag; change the dropdown to retag or untag it." />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding DownloadItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MissingDownloadItem">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Classes="itemTitle" Text="{Binding ModName}" />
                                                <TextBlock Classes="detail" Text="{Binding Reason}" />
                                                <TextBlock FontSize="12" Text="{Binding CurrentStatus}" />
                                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                                           Text="{Binding OverlapSummary}"
                                                           IsVisible="{Binding HasOverlapSummary}" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" Width="170" VerticalAlignment="Top"
                                                      AutomationProperties.Name="{Binding ModName, StringFormat='Tag action for {0}'}"
                                                      ItemsSource="{x:Static vm:MissingDownloadItem.Actions}"
                                                      SelectedIndex="{Binding SelectedActionIndex}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="{Binding WarningsHeader}">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Classes="row">
                                    <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
