<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WabbajackPreprocessor.App.ViewModels"
        xmlns:loc="using:WabbajackPreprocessor.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="650"
        x:Class="WabbajackPreprocessor.App.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="950" Height="650"
        MinWidth="860" MinHeight="480"
        Title="{Binding [WindowTitle], Source={x:Static loc:L.Instance}}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <!-- Fluent bakes a 2px bottom margin under the tab strip directly into the
             TabControl template via this resource; zero it so the selected tab sits
             flush against the content panel. -->
        <Thickness x:Key="TabControlTopPlacementItemMargin">0</Thickness>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.detail">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.itemTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#40808080" />
        </Style>

        <!-- Compact, unmistakably tab-shaped headers on a single non-wrapping strip
             (the Fluent default renders headers as 24px heading text on a WrapPanel).
             The selected tab shares its background with the content panel and sits
             flush against it, so the pair reads as one connected surface; Fluent's
             selection pipe (which hugged the label like an underline) is hidden. -->
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <!-- Fluent's template maps TabControl.Padding to the content host's MARGIN,
             which would open a transparent gap around the panel: zero it and pad
             inside the tinted panel instead. -->
        <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="#20808080" />
            <Setter Property="CornerRadius" Value="0,6,6,6" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
        </Style>
        <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#10808080" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#1A808080" />
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#20808080" />
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Count badges on the tab labels. Space is reserved from launch (hidden via
             opacity, which never triggers layout) so tab widths stay constant when
             counts appear — header-text changes only re-measure the strip on resize. -->
        <Style Selector="Border.countBadge">
            <Setter Property="Background" Value="#3A808080" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.countBadge.active">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.countBadge &gt; TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{Binding [MenuFile], Source={x:Static loc:L.Instance}}">
                <MenuItem Header="{Binding [MenuOpenSettingsFile], Source={x:Static loc:L.Instance}}"
                          InputGesture="Ctrl+O"
                          Command="{Binding #Root.BrowseCommand}" />
                <Separator />
                <MenuItem Header="{Binding [MenuExit], Source={x:Static loc:L.Instance}}"
                          Command="{Binding #Root.ExitCommand}" />
            </MenuItem>
            <MenuItem Header="{Binding [MenuTools], Source={x:Static loc:L.Instance}}">
                <MenuItem Header="{Binding [MenuSettingsItem], Source={x:Static loc:L.Instance}}"
                          Command="{Binding #Root.OpenSettingsCommand}" />
            </MenuItem>
            <MenuItem Header="{Binding [MenuHelp], Source={x:Static loc:L.Instance}}">
                <MenuItem Header="{Binding [MenuGitHub], Source={x:Static loc:L.Instance}}"
                          Command="{Binding #Root.OpenRepoCommand}" />
                <MenuItem Header="{Binding [MenuAbout], Source={x:Static loc:L.Instance}}"
                          Command="{Binding #Root.OpenAboutCommand}" />
            </MenuItem>
        </Menu>

        <DockPanel Margin="12">

        <!-- Top: file selection -->
        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock Text="{Binding [SettingsFileLabel], Source={x:Static loc:L.Instance}}" />
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding SettingsPath}"
                         AutomationProperties.Name="{Binding [SettingsFileAccessibleName], Source={x:Static loc:L.Instance}}"
                         PlaceholderText="{Binding [SettingsFilePlaceholder], Source={x:Static loc:L.Instance}}" />
                <Button Grid.Column="1" Margin="6,0,0,0" Click="OnBrowseClicked"
                        Content="{Binding [BrowseButton], Source={x:Static loc:L.Instance}}" />
                <Button Grid.Column="2" Margin="6,0,0,0" Classes="accent"
                        Command="{Binding AnalyzeCommand}"
                        Content="{Binding [AnalyzeButton], Source={x:Static loc:L.Instance}}" />
            </Grid>
            <TextBlock Classes="detail" Text="{Binding InstanceSummary}" />
            <TextBlock Text="{Binding ProfilesSummary}" TextWrapping="Wrap"
                       IsVisible="{Binding HasAnalysis}" />
        </StackPanel>

        <!-- Bottom: status + apply -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="{Binding [StatusAccessibleName], Source={x:Static loc:L.Instance}}"
                       Text="{Binding StatusMessage}" />
            <Button Grid.Column="1" Classes="accent"
                    Command="{Binding ApplyCommand}"
                    Content="{Binding [ApplyButton], Source={x:Static loc:L.Instance}}" />
        </Grid>

        <!-- Findings -->
        <TabControl Margin="0,10,0,0">

            <TabItem AutomationProperties.Name="{Binding StaleHeader}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding [TabStalePlain], Source={x:Static loc:L.Instance}}" />
                        <Border Classes="countBadge" Classes.active="{Binding HasAnalysis}">
                            <TextBlock Text="{Binding StaleCount}" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="detail" Margin="0,4,0,6"
                               Text="{Binding [DescStale], Source={x:Static loc:L.Instance}}" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding StaleGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StaleGroup">
                                    <StackPanel Margin="0,0,0,14">
                                        <Border BorderThickness="0,0,0,2"
                                                BorderBrush="{DynamicResource SystemAccentColor}"
                                                Padding="0,0,0,4" Margin="0,6,0,0">
                                            <TextBlock FontSize="15" FontWeight="SemiBold"
                                                       Text="{Binding Header}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding SubGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:StaleSubGroup">
                                                    <StackPanel>
                                                        <TextBlock FontSize="13" FontWeight="SemiBold" Opacity="0.85"
                                                                   Margin="0,8,0,2" Text="{Binding Header}" />
                                                        <ItemsControl ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:StaleEntryItem">
                                                                    <Border Classes="row">
                                                                        <Grid ColumnDefinitions="Auto,*">
                                                                            <CheckBox Grid.Column="0" VerticalAlignment="Top"
                                                                                      IsChecked="{Binding Remove}"
                                                                                      AutomationProperties.Name="{Binding RemoveAccessibleName}" />
                                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                                <TextBlock Classes="itemTitle" Text="{Binding Entry}" />
                                                                                <TextBlock Classes="detail" Text="{Binding Detail}"
                                                                                           IsVisible="{Binding HasDetail}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem AutomationProperties.Name="{Binding RedundantHeader}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding [TabRedundantPlain], Source={x:Static loc:L.Instance}}" />
                        <Border Classes="countBadge" Classes.active="{Binding HasAnalysis}">
                            <TextBlock Text="{Binding RedundantCount}" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="detail" Margin="0,4,0,6"
                               Text="{Binding [DescRedundant], Source={x:Static loc:L.Instance}}" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding RedundantItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StaleEntryItem">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <CheckBox Grid.Column="0" VerticalAlignment="Top"
                                                      IsChecked="{Binding Remove}"
                                                      AutomationProperties.Name="{Binding RemoveAccessibleName}"
                                                      ToolTip.Tip="{Binding [RemoveAETagTooltip], Source={x:Static loc:L.Instance}}" />
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Classes="itemTitle" Text="{Binding Entry}" />
                                                <TextBlock Classes="detail" Text="{Binding Detail}"
                                                           IsVisible="{Binding HasDetail}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem AutomationProperties.Name="{Binding DisabledHeader}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding [TabDisabledPlain], Source={x:Static loc:L.Instance}}" />
                        <Border Classes="countBadge" Classes.active="{Binding HasAnalysis}">
                            <TextBlock Text="{Binding DisabledCount}" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="detail" Margin="0,4,0,6"
                               Text="{Binding [DescDisabled], Source={x:Static loc:L.Instance}}" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding DisabledItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DisabledModItem">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <CheckBox Grid.Column="0" VerticalAlignment="Top"
                                                      IsChecked="{Binding MarkAlwaysEnabled}"
                                                      AutomationProperties.Name="{Binding MarkAccessibleName}"
                                                      ToolTip.Tip="{Binding [MarkAETooltip], Source={x:Static loc:L.Instance}}" />
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Classes="itemTitle" Text="{Binding ModName}" />
                                                <TextBlock Classes="detail" Text="{Binding Note}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem AutomationProperties.Name="{Binding DownloadsHeader}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding [TabNoDownloadPlain], Source={x:Static loc:L.Instance}}" />
                        <Border Classes="countBadge" Classes.active="{Binding HasAnalysis}">
                            <TextBlock Text="{Binding DownloadCount}" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="detail" Margin="0,4,0,6"
                               Text="{Binding [DescNoDownload], Source={x:Static loc:L.Instance}}" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding DownloadItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MissingDownloadItem">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Classes="itemTitle" Text="{Binding ModName}" />
                                                <TextBlock Classes="detail" Text="{Binding Reason}" />
                                                <TextBlock FontSize="12" Text="{Binding CurrentStatus}" />
                                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                                           Text="{Binding OverlapSummary}"
                                                           IsVisible="{Binding HasOverlapSummary}" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" Width="170" VerticalAlignment="Top"
                                                      AutomationProperties.Name="{Binding TagActionAccessibleName}"
                                                      ItemsSource="{x:Static vm:MissingDownloadItem.Actions}"
                                                      SelectedIndex="{Binding SelectedActionIndex}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem AutomationProperties.Name="{Binding WarningsHeader}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding [TabWarningsPlain], Source={x:Static loc:L.Instance}}" />
                        <Border Classes="countBadge" Classes.active="{Binding HasAnalysis}">
                            <TextBlock Text="{Binding WarningCount}" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Classes="row">
                                    <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

        </TabControl>
        </DockPanel>
    </DockPanel>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding #Root.BrowseCommand}" />
    </Window.KeyBindings>
</Window>
